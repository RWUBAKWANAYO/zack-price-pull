{
  "name": "@monochrome/zack-price-pull",
  "private": true,
  "description": "Competitor price pull for Zack. Each page source (Uber, Bolt, and later ones) returns the same product list.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "login": "PLAYWRIGHT_BROWSERS_PATH=0 node src/login.js",
    "quote": "PLAYWRIGHT_BROWSERS_PATH=0 node src/quote.js",
    "start": "PLAYWRIGHT_BROWSERS_PATH=0 node src/server.js",
    "test": "node --test test/parseProducts.test.js test/quote.test.js test/auth.test.js test/session.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "node-html-parser": "^6.1.13",
    "playwright": "^1.49.1"
  }
}
